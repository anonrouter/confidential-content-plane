# L7 routing behind dstack-ingress, inside the same measured trust domain.
# dstack-ingress owns :443 and forwards plain HTTP here only after terminating
# the client's TLS inside the TD. This image has no routable network.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	# A CEILING ON EVERY REQUEST BODY, matching deploy/caddy/Caddyfile:165-166 and
	# deploy/phala/Caddyfile.cvm:23-24. This edge had NO site-level limit at all --
	# only 64KB blocks on the three credential routes -- so every other path,
	# including chat completions, was bounded solely by the relay's own
	# REQUEST_BODY_LIMIT_BYTES. That is a real limit, but it is enforced after the
	# body has been accepted into the trust domain. The sibling edges both stop it
	# here; this one silently did not.
	request_body {
		max_size 10MB
	}

	# Operator and internal surfaces do not exist on this origin. Defense in
	# depth: the roles themselves also refuse these paths.
	@internal path /internal /internal/* /readyz /healthz/crypto
	handle @internal {
		respond 404
	}
	@admin path /v1/admin /v1/admin/*
	handle @admin {
		respond 404
	}

	# /v1/audio/speech IS RETIRED, and this is the enforcement point.
	#
	# DECISIONS_CONTENT_PLANE.md records it as one of three endpoints retired
	# outright because they join content to identity. The application agrees --
	# there is no relay route, no speech worker in any compose file, and no
	# "speech" member of InferenceOperation, so no ticket for it can even be
	# minted -- but until now the edge expressed that only as a fall-through to
	# the catch-all 404 at the bottom of this file.
	#
	# A fall-through is not a decision. It is indistinguishable from a typo'd URL,
	# and it survives only as long as nobody adds a broader matcher above it. This
	# says no explicitly, first, before any other matcher can claim the path.
	#
	# 503 media_disabled, NOT 404, because that is what every application path
	# already returns for this endpoint (src/routes/mediaDisabled.ts:26). A client
	# that branches on `type == "media_disabled"` behaves the same whether it
	# reached the edge or the app. Changing the answer to 404 at the edge would be
	# a silent API break dressed up as hardening.
	#
	# The refusal happens HERE so the body stops at the edge. Caddy answers from
	# this matcher without proxying, so no request body reaches control, and on a
	# deployment whose catch-all proxies to control (deploy/caddy/Caddyfile) that
	# is the entire point: the user's text would otherwise arrive on the accounts
	# host alongside their session cookie.
	@speech_retired path /v1/audio/speech /v1/audio/speech/*
	handle @speech_retired {
		header Content-Type application/json
		respond `{"error":{"message":"Media generation is not enabled on this deployment","type":"media_disabled"}}` 503
	}

	# CORS preflight must be ROUTED, not 404ed, or the browser reports a
	# CORS failure for a request the relay never saw. @fastify/cors owns the
	# allowlist, not this file.
	# /v1/models IS IN THIS LIST, and its absence was a real browser blocker.
	#
	# A browser preflights any cross-origin GET carrying Authorization. That
	# OPTIONS fell through to the catch-all 404 below, which carries no CORS
	# headers at all, so Chrome reported "No 'Access-Control-Allow-Origin'
	# header is present" and refused to send the GET. The model list never
	# loaded, and nothing appeared in any backend log because the request never
	# reached a backend -- exactly the failure the comment above describes.
	#
	# curl cannot catch this: it does not enforce CORS, so every curl check
	# against this path passed while the browser could not read it.
	@preflight {
		method OPTIONS
		path /v1/chat/completions /v1/e2ee/chat/completions /v1/embeddings /v1/tee/attestation /v1/models /v1/images/generations
	}
	handle @preflight {
		reverse_proxy relay:3000
	}
	@compat_preflight {
		method OPTIONS
		path /compat/v1/*
	}
	handle @compat_preflight {
		reverse_proxy compat:3000
	}
	@attest_preflight {
		method OPTIONS
		path /v1/gateway/attestation
	}
	handle @attest_preflight {
		reverse_proxy attest:3000
	}

	# Gateway attestation: isolated service, credential-free, no content.
	@gateway_attestation {
		method GET
		path /v1/gateway/attestation
	}
	handle @gateway_attestation {
		reverse_proxy attest:3000
	}

	# Public evidence generated by dstack-ingress. It contains certificates and
	# attestation material, never application content or credentials.
	@evidences path /evidences /evidences/*
	handle @evidences {
		root * /evidences
		file_server browse
	}

	# The OpenAI-compatible broker, for stock clients holding an ar_ key.
	@compat path /compat/v1/*
	handle @compat {
		uri strip_prefix /compat
		reverse_proxy compat:3000
	}

	# Per-request receipt verification, served by the content tier because the
	# exact request and response hashes it resolves never leave this trust
	# domain. Authorized by possession of the 128-bit receipt id in the path;
	# there is no listing route and no other way to reach a binding.
	@receipt {
		method GET
		path /v1/tee/receipt/*
	}
	handle @receipt {
		reverse_proxy relay:3000 {
			header_up -Authorization
			header_up -Cookie
		}
	}

	# Provider-credential administration, terminating in the credential worker.
	#
	# A DELIBERATE PUBLIC SURFACE. The whole point of the launch flow is that an
	# operator's verifying client reaches the attested workload DIRECTLY, over
	# TLS that terminated inside this TD, so there is no other way in: routing
	# this from outside is the design, not a concession to it.
	#
	# Exposed under /v1/credentials and rewritten, so the blanket
	# "/internal does not exist on this origin" rule above stays intact rather
	# than acquiring an exception. Only three exact routes and two methods pass.
	# Authorization is the capability signature the worker verifies; nothing
	# here authenticates, because a client cannot be asked to authenticate to
	# something it has not yet decided to trust.
	@credential_identity {
		method GET
		path /v1/credentials/identity
	}
	handle @credential_identity {
		rewrite * /internal/credentials/identity
		reverse_proxy venice-worker:3000
	}
	# Two exact routes, rewritten one at a time. A strip-then-rewrite pair would
	# depend on Caddy's directive ordering to produce the right path, and a
	# route that reaches the credential holder is the wrong place to rely on
	# that being what one expects.
	@credential_secret {
		method POST
		path /v1/credentials/secret
	}
	handle @credential_secret {
		request_body {
			# A capability plus one provider secret. Nothing legitimate on this
			# path is large, and a small ceiling is one less thing to reason
			# about on a route that reaches the credential holder.
			max_size 64KB
		}
		rewrite * /internal/credentials/secret
		reverse_proxy venice-worker:3000
	}
	@credential_revoke {
		method POST
		path /v1/credentials/revoke
	}
	handle @credential_revoke {
		request_body {
			max_size 64KB
		}
		rewrite * /internal/credentials/revoke
		reverse_proxy venice-worker:3000
	}

	# Trailing-slash variants are not canonical routes; refuse rather than
	# let a proxy normalize them into one.
	@relay_noncanonical path /v1/chat/completions/* /v1/e2ee/chat/completions/* /v1/embeddings/* /v1/tee/attestation/* /v1/images/generations/* /v1/credentials/*/*
	handle @relay_noncanonical {
		respond 404
	}

	# Stock OpenAI clients use the ordinary /v1 base URL with an ar_ key.
	# Ticket-authenticated native traffic falls through to the relay below.
	@compat_static {
		method POST GET
		path /v1/models /v1/chat/completions /v1/embeddings
		header Authorization "Bearer ar_*"
	}
	handle @compat_static {
		reverse_proxy compat:3000
	}

	# /v1/images/generations IS IN THIS LIST, and adding it is a fail-closed change.
	#
	# It works on the live Hetzner edge (deploy/caddy/Caddyfile:241) and on the dev
	# CVM edge (Caddyfile.cvm:91) and was absent only here, so moving the hostname
	# to this edge would have turned a documented answer into a bare 404 from a
	# proxy -- a routing regression that looks like a client bug.
	#
	# It does NOT switch image generation on. IMAGE_GENERATION_ENABLED is "false"
	# on this relay (docker-compose.prod5-xl.yml:151) and on control, so the relay
	# registers registerDisabledImageRoute, which refuses in `onRequest` BEFORE the
	# body is parsed, and control refuses to mint an image ticket at all. The
	# request now reaches a service that says 503 media_disabled -- exactly what
	# Hetzner says today -- instead of a proxy that says 404. Enabling it is three
	# further coordinated changes (control flag, relay flag + its generator, then
	# this file), and because the relay enforces the flag server-side, an edge-only
	# change cannot open it by accident.
	@relay {
		method POST GET
		path /v1/chat/completions /v1/e2ee/chat/completions /v1/embeddings /v1/tee/attestation /v1/models /v1/images/generations
	}
	handle @relay {
		reverse_proxy relay:3000 {
			# Streaming completions are the reason. Both sibling edges set this
			# (deploy/caddy/Caddyfile:245, Caddyfile.cvm:95) and this one did not,
			# so it depended on Caddy's content-type sniffing to avoid buffering an
			# SSE response. Explicit here, as it is everywhere else.
			flush_interval -1
		}
	}

	handle /healthz {
		reverse_proxy relay:3000
	}

	handle {
		respond 404
	}
}
