# Edge router for the pooled content plane: credential routes to the pool worker.
#
# Built ON TOP of the measured single-provider edge image, exactly as the
# xlarge edge is. Only the Caddyfile differs, so this is a "pinned base plus one
# file" build: reproducible, daemon-free, and byte-identical across machines.
#
# The base under that image is AnonRouter's own scratch-built caddy base,
# sha256:62c3df7708bf00f13240cb028cba40d44757ea5c6c8584bc8867e288a61555f5,
# which never sets the caddy file capability. Under `cap_drop: ALL` a file
# capability is fatal at execve, so the property still has to hold; it is
# asserted in the base build.
#
# GENERATED by deploy/phala/gen-edge-pool.mjs. Do not hand-edit.
FROM ghcr.io/anonrouter/anonrouter-edge-ingress@sha256:154de881e313db9181b714cba7592d1aa4e0952b2e7bf631812b4eab8a56c21f
COPY Caddyfile /etc/caddy/Caddyfile
